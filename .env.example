# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (Application User - Restricted Privileges)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/tmp/mysql.sock
DB_NAME=crowdfunding_platform
DB_USER=crowd_app
DB_PASSWORD=replace_with_app_password

# Database Admin Connection (Used only for migrations/DDL)
DB_ADMIN_USER=crowd_admin
DB_ADMIN_PASSWORD=replace_with_admin_password

# External Drive and MySQL System Paths
MYSQL_BIN_DIR=/usr/local/mysql/bin
MYSQL_DATA_DIR=/Volumes/External drive/MySQL/Data
MYSQL_CNF=

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_crowdfunding_min_32_chars_long
JWT_EXPIRES_IN=7d
